---
<div class="bg-linear-to-b from-[#FFE2D7] to-[#FDFBF7] flex flex-col justify-between w-full">
    <div class="grid grid-cols-5 my-40">
        
        <div id="hero" class="pl-20 py-30 col-start-1 col-end-4 translate-x-[-300px] opacity-0 transition-all duration-2500">
            <h1 class="text-7xl font-bold my-8">
                We create 
                <span class="text-[#FF0000]">mobile</span>, <span class="text-[#0055FF]">web</span> & <span class="text-[#6CB900]">AI</span> apps
            </h1>
            <p class="font-semibold text-2xl text-gray-500">We're an app development agency that specialises in audience<br>engagement, ecommerce and simplifying your businesses<br>painful processes</p>

            <button class="my-10 bg-[#404040] hover:opacity-80 text-white font-semibold py-3 px-4 border rounded-md">
                Let’s get started!
            </button>
        </div>
        <div class="col-span-2 col-end-6 text-center">
            <img src="images/hero-image.png" alt="Hero Image" class="w-auto h-auto"/>
        </div>
    </div>

    <div class="overflow-hidden p-4">
        <div class="marquee p-4">
            <div class="track">
            <div class="px-4 py-2 bg-blue-500 text-white rounded w-full">Brand 1</div>
            <div class="px-4 py-2 bg-green-500 text-white rounded w-full">Brand 2</div>
            <div class="px-4 py-2 bg-cyan-500 text-white rounded w-full">Brand 3</div>
            <div class="px-4 py-2 bg-yellow-500 text-black rounded w-full">Brand 4</div>
            <div class="px-4 py-2 bg-red-500 text-white rounded w-full">Brand 5</div>
            <div class="px-4 py-2 bg-purple-500 text-white rounded w-full">Brand 6</div>
            <div class="px-4 py-2 bg-pink-500 text-white rounded w-full">Brand 7</div>
            <div class="px-4 py-2 bg-indigo-500 text-white rounded w-full">Brand 8</div>
            <div class="px-4 py-2 bg-teal-500 text-white rounded w-full">Brand 9</div>
            <div class="px-4 py-2 bg-orange-500 text-white rounded w-full">Brand 10</div>

            <div class="px-4 py-2 bg-blue-500 text-white rounded w-full">Brand 1</div>
            <div class="px-4 py-2 bg-green-500 text-white rounded w-full">Brand 2</div>
            <div class="px-4 py-2 bg-cyan-500 text-white rounded w-full">Brand 3</div>
            <div class="px-4 py-2 bg-yellow-500 text-black rounded w-full">Brand 4</div>
            <div class="px-4 py-2 bg-red-500 text-white rounded w-full">Brand 5</div>
            <div class="px-4 py-2 bg-purple-500 text-white rounded w-full">Brand 6</div>
            <div class="px-4 py-2 bg-pink-500 text-white rounded w-full">Brand 7</div>
            <div class="px-4 py-2 bg-indigo-500 text-white rounded w-full">Brand 8</div>
            <div class="px-4 py-2 bg-teal-500 text-white rounded w-full">Brand 9</div>
            <div class="px-4 py-2 bg-orange-500 text-white rounded w-full">Brand 10</div>

            <div class="px-4 py-2 bg-blue-500 text-white rounded w-full">Brand 1</div>
            <div class="px-4 py-2 bg-green-500 text-white rounded w-full">Brand 2</div>
            <div class="px-4 py-2 bg-cyan-500 text-white rounded w-full">Brand 3</div>
            <div class="px-4 py-2 bg-yellow-500 text-black rounded w-full">Brand 4</div>
            <div class="px-4 py-2 bg-red-500 text-white rounded w-full">Brand 5</div>
            <div class="px-4 py-2 bg-purple-500 text-white rounded w-full">Brand 6</div>
            <div class="px-4 py-2 bg-pink-500 text-white rounded w-full">Brand 7</div>
            <div class="px-4 py-2 bg-indigo-500 text-white rounded w-full">Brand 8</div>
            <div class="px-4 py-2 bg-teal-500 text-white rounded w-full">Brand 9</div>
            <div class="px-4 py-2 bg-orange-500 text-white rounded w-full">Brand 10</div>
        </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT -->
<script is:inline>
  window.addEventListener("load", () => {
    const el = document.getElementById("hero");
    el.classList.remove("translate-x-[-300px]", "opacity-0");
    el.classList.add("translate-x-0", "opacity-100");
  });
</script>

<!-- CSS -->
<style>
.marquee {
  overflow: hidden;
  white-space: nowrap;
}

.track {
  display: inline-flex;
  gap: 2rem;
  animation: scroll 15s linear infinite;
}

@keyframes scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}
</style>