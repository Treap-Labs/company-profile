<section id="contactus" class="bg-linear-to-b from-[#FDFBF7] to-[#FFE2D7] p-8">
    <div class="px-15 grid grid-cols-2">
        <div class="flex flex-col justify-center p-4 gap-4">
            <h1 class="font-extrabold text-7xl">Contact Us</h1>

            <div class="grid grid-cols-2">
                <div class="flex flex-col">
                    <h3 class="font-bold text-gray-900 text-lg">Email</h3>
                    <p class="text-gray-700">info@treaplabs.com</p>
                </div>

                <div class="flex flex-col">
                    <h3 class="font-bold text-gray-900 text-lg">Phone</h3>
                    <p class="text-gray-700"> +1 (123) 456-7890</p>
                </div>
            </div>

            <div class="pt-4">
                <a href="#" class="inline-block text-white bg-black px-16 py-3 rounded-lg hover:bg-gray-700 transition-colors">Send Message</a>
            </div>
        </div>
        <div class="bg-[#FFE6BC] m-8 p-6 rounded-2xl">
            <h1 class="font-bold text-3xl">Get in Touch</h2>
            <form action="#" class="pt-4">

                <div class="grid grid-cols-2 gap-2 pt-2">
                    <div class="flex flex-col gap-1">
                        <label for="name" class="text-sm">Name</label>
                        <input type="text" name="name" id="name" class="bg-white rounded-md py-2 px-4" placeholder="John">
                    </div>
                    <div class="flex flex-col gap-1">
                        <label for="surname" class="text-sm">Surname</label>
                        <input type="text" name="surname" id="surname"  class="bg-white rounded-md py-2 px-4" placeholder="Doe">
                    </div>
                </div>

                <div class="flex flex-col gap-1 pt-2">
                    <label for="email" class="text-sm">Mail</label>
                    <input type="email" name="email" id="email" class="bg-white rounded-md py-2 px-4" placeholder="johndoe@mail.net">
                </div>

                <div class="flex flex-col gap-1 pt-2">
                    <label for="address" class="text-sm">Address</label>
                    <input type="text" name="address" id="address" class="bg-white rounded-md py-2 px-4" placeholder="Capitor, WA">
                </div>

                <div class="flex flex-col gap-1 pt-2">
                    <label for="descripction" class="text-sm">Description</label>
                    <textarea name="description" id="description" rows="4" maxlength="255" class="bg-white rounded-md py-2 px-4 resize-none"></textarea>
                </div>

                <div class="flex pt-2">
                    <button type="submit" class="text-white bg-black px-16 py-3 rounded-lg hover:bg-gray-700 transition-colors w-full">Send Message</button>
                </div>
            </form>
        </div>
    </div>
</section>