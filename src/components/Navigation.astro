<div class="p-6 fixed grid grid-cols-3 backdrop-blur-sm w-full z-50">
    <div class="px-4  flex flex-row items-center">
        <img src="treaplabs-logo.png" alt="Treap Labs Logo" class="h-10 px-2"/>
        <a class="px-2 text-xl font-bold">Treap Labs</a>
    </div>
    <div class="flex flex-row justify-center">
        <div class="px-4 flex flex-row items-center">
            <a href="#home" class="nav-link relative flex flex-col items-center cursor-pointer font-semibold" >
                <span class="dot absolute -top-2 w-2.5 h-2.5 bg-red-500 rounded-full opacity-0 scale-0 transition-all duration-300"></span>
                Home</a>
        </div>
        <div class="px-4 flex flex-row items-center">
            <a href="#productandservices" class="nav-link relative flex flex-col items-center cursor-pointer font-semibold" >
                <span class="dot absolute -top-2 w-2.5 h-2.5 bg-red-500 rounded-full opacity-0 scale-0 transition-all duration-300"></span>
                Services</a>
        </div>
        <div class="px-4 flex flex-row items-center">
            <a href="#team" class="nav-link relative flex flex-col items-center cursor-pointer font-semibold" >
                <span class="dot absolute -top-2 w-2.5 h-2.5 bg-red-500 rounded-full opacity-0 scale-0 transition-all duration-300"></span>
                Team</a>
        </div>
        <div class="px-4 flex flex-row items-center">
            <a href="#testimonials" class="nav-link relative flex flex-col items-center cursor-pointer font-semibold" >
                <span class="dot absolute -top-2 w-2.5 h-2.5 bg-red-500 rounded-full opacity-0 scale-0 transition-all duration-300"></span>
                Testimonials</a>
        </div>
        <div class="px-4 flex flex-row items-center">
            <a href="#contactus" class="nav-link relative flex flex-col items-center cursor-pointer font-semibold" >
                <span class="dot absolute -top-2 w-2.5 h-2.5 bg-red-500 rounded-full opacity-0 scale-0 transition-all duration-300"></span>
                Contact</a>
        </div>

    </div>
    <div class="mx-8 px-4 text-right">
        <button class="bg-[#795933] hover:bg-[#B47F43] text-white font-semibold py-2 px-4 border rounded-md">
            START YOUR PROJECT
        </button>
    </div>

</div>


<!-- JAVASCRIPT -->
<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll(".nav-link");
    const sections = document.querySelectorAll("section");

    function setActive(id) {
        links.forEach(link => {
            const dot = link.querySelector(".dot");

            link.classList.remove("text-red-500");
            dot.classList.add("opacity-0", "scale-0");

            if (link.getAttribute("href") === "#" + id) {
                link.classList.add("text-red-500");
                dot.classList.remove("opacity-0", "scale-0");
            }
        });
    }

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    setActive(entry.target.id);
                }
            });
        },
        {
            threshold: 0.6 // section considered active when 60% visible
        }
    );

    sections.forEach(section => {
        observer.observe(section);
    });
});
</script>